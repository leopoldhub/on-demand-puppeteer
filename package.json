{
  "name": "on-demand-puppeteer",
  "version": "1.0.0",
  "description": "On-demand, profile-isolated Puppeteer CDP provider",
  "repository": "https://github.com/leopoldhub/on-demand-puppeteer",
  "bugs": "https://github.com/leopoldhub/on-demand-puppeteer/issues",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.8.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
